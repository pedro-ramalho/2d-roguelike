.menu-panel {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.overlay-panel {
    flex-grow: 1;
    display: none;
    justify-content: center;
    align-items: center;
}

.panel-label {
    -unity-font-definition: url("project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf");
    color: rgb(255, 255, 255);
    -unity-text-align: middle-center;
}

.menu-title {
    -unity-font-definition: url("project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf");
    color: rgb(255, 255, 255);
    font-size: 48px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(27, 27, 27);
    margin-bottom: 64px;
}

.credit-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 24px;
}

.credit-icon {
    width: 36px;
    height: 36px;
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 12px;
}

.credit-label {
    font-size: 24px;
}

.menu-button {
    -unity-font-definition: url("project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf");
    font-size: 28px;
    width: 456px;
    height: 48px;
    margin-bottom: 16px;
    background-color: rgb(36, 36, 36);
    color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgb(255, 255, 255);
}

.menu-button:hover {
    background-color: rgb(85, 85, 85);
}
