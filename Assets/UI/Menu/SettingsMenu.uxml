    <ui:VisualElement name="SettingsMenuPanel" style="flex-grow: 1; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); -unity-text-align: middle-center; align-items: center; align-self: auto; flex-direction: column; justify-content: center; align-content: auto; display: none;">
