.combatant-hud {
    position: absolute;
    width: 0;
    height: 0;
    visibility: hidden;
}

.hud-content {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    translate: -50% 0;
    flex-direction: column;
    align-items: center;
}

.bar {
    position: relative;
    width: 100%;
    height: 4px;
    background-color: rgb(30, 30, 30);
    margin-top: 1px;
}

.bar-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
}

.bar-fill-hp {
    background-color: rgb(200, 40, 40);
}

.bar-fill-block {
    background-color: rgb(50, 90, 200);
}

.status-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 1px;
}

.status-slot {
    flex-direction: row;
    align-items: center;
}

.status-icon {
    width: 16px;
    height: 16px;
    background-color: rgb(180, 180, 180);
}

.status-duration {
    font-size: 8px;
    color: rgb(255, 255, 255);
    margin-left: 1px;
}

.floater {
    position: absolute;
    font-size: 14px;
    color: rgb(255, 255, 255);
}

.player-stats-panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    background-color: rgba(20, 20, 20, 0.95);
    padding: 8px 12px;
}

.player-stats-label {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-text-align: middle-left;
}

Label {
    -unity-font-definition: url("project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&guid=b284a6525342f44599e9ce79e37c2d61&type=3#PressStart2P-Regular");
}
