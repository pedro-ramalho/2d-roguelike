<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="PlayerStatsPanel" style="flex-grow: 1; left: 0; right: 0; bottom: 0; position: absolute; align-self: flex-start; align-content: center; -unity-text-align: middle-left; flex-direction: row; justify-content: space-between; align-items: center; margin-right: 12px; padding-right: 30%; margin-top: 12px; margin-bottom: 12px; margin-left: 12px;">
        <ui:Label text="HP: X/Y" name="HealthLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 24px; -unity-text-align: upper-center; position: relative; bottom: 0; left: 0; right: 0; top: auto; align-items: auto; align-content: auto; padding-right: 32px;"/>
        <ui:Label text="Block: X" name="BlockLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 24px; -unity-text-align: upper-center; position: relative; bottom: 0; left: 0; right: 0; top: auto; align-items: auto; align-content: auto; padding-right: 32px;"/>
        <ui:Label text="Stamina: X" name="StaminaLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 24px; -unity-text-align: upper-center; position: relative; bottom: 0; left: 0; right: 0; top: auto; align-items: auto; align-content: auto; padding-right: 32px;"/>
        <ui:Label text="Attack: X" name="AttackLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 24px; -unity-text-align: upper-center; position: relative; bottom: 0; left: 0; right: 0; top: auto; align-items: auto; align-content: auto; padding-right: 32px;"/>
    </ui:VisualElement>
    <ui:VisualElement name="GameOverPanel" style="flex-grow: 1; position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.8); align-items: center; justify-content: space-around;">
        <ui:Label text="Game Over" name="GameOverMessage" style="align-items: center; justify-content: space-around; color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;);"/>
    </ui:VisualElement>
    <ui:VisualElement name="LevelTransitionPanel" picking-mode="Ignore" style="flex-grow: 1; width: 100%; position: absolute; height: 100%; background-color: rgb(0, 0, 0); opacity: 0; justify-content: center;">
        <ui:Label text="Level:" name="NewLevelLabel" style="color: rgb(255, 255, 255); align-items: center; justify-content: flex-start; align-self: center; align-content: center; top: auto; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); font-size: 18px;"/>
    </ui:VisualElement>
</ui:UXML>
